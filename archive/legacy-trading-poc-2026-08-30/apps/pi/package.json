    "typebox": "1.3.12",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.0",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
