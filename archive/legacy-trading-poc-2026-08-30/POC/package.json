{
  "name": "agentic-trading-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Local Electron frontend for the Rust trading adapter.",
  "main": "apps/electron/main.cjs",
  "scripts": {
    "live:app": "scripts/open-live-frontends.sh",
    "live:frontends": "scripts/open-live-frontends.sh",
    "electron": "electron apps/electron/main.cjs",
    "snapshot:electron": "electron apps/electron/main.cjs --snapshot /tmp/agentic-trading-electron.png --width 1586 --height 992",
    "verify:electron": "node apps/electron/scripts/verify-electron.mjs",
    "verify:frontend": "node scripts/verify-frontend-parity.mjs",
    "verify:live-frontends": "scripts/validate-live-frontends.sh",
    "verify:snapshots": "node scripts/verify-snapshots.mjs --electron /tmp/trading-local-validation/electron-1586x992.png"
  },
  "devDependencies": {
    "electron": "^39.2.6"
  }
}
